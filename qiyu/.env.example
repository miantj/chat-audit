# 可选：自动登录七鱼后台；也可直接在专用 Chrome 中手动登录
QIYU_USERNAME=your_username
QIYU_PASSWORD=your_password
# OS 权威疑似 C 端查询：Cookie 可选；缺失或明确过期时自动登录，本次任务最多登录一次
# 新 Cookie 仅在本次任务内复用，不回写此文件；接口/登录失败则保留原 CSV 并报错
# 登录凭据仅保存在本地忽略的 .env，勿提交；password 使用登录接口所需的现有摘要，不是明文密码
QIYU_OS_LOGIN_NAME=
QIYU_OS_LOGIN_PASSWORD=
QIYU_OS_LOGIN_PHONE=
# 可选：已有的 OS 登录会话 Cookie，例如：YISHOUSESS=...; token=...
# Node 20.12+；查无用户/无有效 ID 留空；普通业务错误、网络错误或权限不足不触发登录
QIYU_OS_COOKIE=
# 售前登记写入的飞书知识库表格（默认「售前登记」知识空间）
# QIYU_LARK_SHEET_URL=https://yb7ao262ru.feishu.cn/wiki/Y8niwzMiliLdyUkb21VcMVqHnMe?sheet=ej5BzF
